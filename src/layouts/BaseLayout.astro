---
import '../styles/global.css';
import { SITE_LOCALE, BRAND_COLOR_NAVY } from '../consts';
import Seo from '../components/Seo.astro';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  exactTitle?: string;
  description?: string;
  ogType?: 'website' | 'article';
  image?: string;
  noindex?: boolean;
}

const { title, exactTitle, description, ogType, image, noindex } = Astro.props;
---

<!doctype html>
<html lang={SITE_LOCALE}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content={BRAND_COLOR_NAVY} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <Seo title={title} exactTitle={exactTitle} description={description} ogType={ogType} image={image} noindex={noindex} />

    {/* Google Analytics 4（本番ビルドのみ・全ページ 1 回） */}
    <GoogleAnalytics />

    <!-- ページ固有の <head> 追加分（JSON-LD など） -->
    <slot name="head" />
  </head>

  <body>
    <a href="#main" class="skip-link">本文へスキップ</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <!--
      Analytics シム（クリック計測）。
      data-analytics-event を持つ要素のクリックを 1 つの document リスナーで拾う。
      - 従来どおり window.dataLayer にプレーンオブジェクトを push（GTM 用の受け皿。
        現状 GTM は未使用で、この push は gtag.js には解釈されず GA4 へは送信されない）。
      - さらに data-analytics-event が app_store_click / guide_link_click のときは、
        同じイベント名で GA4 へ 1 回だけ送信する。パラメータ名は
        link_url / link_location / link_work / page_path で統一し、
        link_work は data-analytics-work がある要素だけに付ける（無ければキー自体を送らない）。
        個人情報（uid・メール・ユーザー入力内容など）は一切含めない。
        window.gtag が無い場合（開発サーバー・広告ブロッカー等）は何もせず、
        リンク本来の遷移は妨げない（preventDefault / 待機なし）。
      GA4 の基本タグ・page_view・拡張計測の click は <GoogleAnalytics /> 側でそのまま。
    -->
    <script>
      type AnalyticsPayload = {
        event: string;
        location: string | null;
        work: string | null;
        href: string | null;
      };

      // GA4 へ実際に送信するイベント名（この2つだけ。他の data-analytics-event 値は
      // dataLayer への push のみで、GA4 へは送らない）。
      const GA4_FORWARDED_EVENTS = new Set(['app_store_click', 'guide_link_click']);

      window.dataLayer = window.dataLayer || [];

      document.addEventListener('click', (e) => {
        const target = e.target as HTMLElement | null;
        // リンク内の文字やアイコンを押しても対象リンクを取得できるよう closest を使う
        const el = target?.closest<HTMLElement>('[data-analytics-event]');
        if (!el) return;

        const analyticsEvent = el.dataset.analyticsEvent ?? 'unknown';
        const location = el.dataset.analyticsLocation ?? null;
        const work = el.dataset.analyticsWork ?? null;
        const href = el.getAttribute('href');

        const payload: AnalyticsPayload = {
          event: analyticsEvent,
          location,
          work,
          href,
        };
        window.dataLayer.push(payload);

        // GA4: app_store_click / guide_link_click を、そのままのイベント名で 1 回だけ送信
        if (GA4_FORWARDED_EVENTS.has(analyticsEvent) && typeof window.gtag === 'function') {
          window.gtag('event', analyticsEvent, {
            link_url: href,
            link_location: location ?? 'unknown',
            ...(work ? { link_work: work } : {}),
            page_path: window.location.pathname,
          });
        }
      });
    </script>
  </body>
</html>
