---
/**
 * ページ共通の <head> メタ情報。
 * title / description / canonical / OGP / Twitter Card / robots を一括生成する。
 */
import {
  SITE_NAME,
  SITE_URL,
  SITE_DESCRIPTION,
  SITE_LOCALE_OG,
  DEFAULT_OG_IMAGE,
} from '../consts';

interface Props {
  title?: string;
  description?: string;
  /** OGP タイプ（トップ・一覧は website、記事は article） */
  ogType?: 'website' | 'article';
  /** OGP 画像パス（サイト内絶対パス or 完全 URL） */
  image?: string;
  /** true の場合 noindex を出力（下書きプレビューなど） */
  noindex?: boolean;
}

const {
  title,
  description = SITE_DESCRIPTION,
  ogType = 'website',
  image,
  noindex = false,
} = Astro.props;

// image 未指定なら DEFAULT_OG_IMAGE（空なら画像メタを出力しない）
const resolvedImage = image ?? DEFAULT_OG_IMAGE;
// 既定の OG 画像は 1200x630 と分かっているので寸法メタを出せる
const isDefaultImage = !image && Boolean(DEFAULT_OG_IMAGE);

// タイトルはページ固有 + サイト名。トップページはサイト名のみ。
const pageTitle = title ? `${title} | ${SITE_NAME}` : `${SITE_NAME} - 登場人物を整理して、もっと作品を楽しむ。`;

// canonical / OGP URL は site を基準に現在ページの pathname から生成
const canonical = new URL(Astro.url.pathname, SITE_URL).href;
const ogImage = resolvedImage ? new URL(resolvedImage, SITE_URL).href : null;
---

<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />

{noindex
  ? <meta name="robots" content="noindex, nofollow" />
  : <meta name="robots" content="index, follow, max-image-preview:large" />}

<!-- Open Graph -->
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:type" content={ogType} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
{ogImage && <meta property="og:image" content={ogImage} />}
{ogImage && <meta property="og:image:alt" content={`${SITE_NAME}`} />}
{isDefaultImage && (
  <>
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
  </>
)}
<meta property="og:locale" content={SITE_LOCALE_OG} />

<!-- Twitter Card -->
<meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
{ogImage && <meta name="twitter:image" content={ogImage} />}
