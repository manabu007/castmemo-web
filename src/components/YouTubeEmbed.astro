---
/**
 * YouTube 動画の埋め込み（作品ガイドで再利用）。
 *
 * - youtube-nocookie.com を使う（プライバシー強化モード）
 * - loading="lazy" ＋ 16:9 の aspect-ratio 枠でレイアウトシフトを防ぐ
 * - 自動再生はしない（src に autoplay を付けない）
 *
 * <YouTubeEmbed id="xxxx" title="……（公式ティザー）" />
 */
interface Props {
  /** YouTube の動画 ID */
  id: string;
  /** iframe の title（スクリーンリーダー・タブ用。動画の内容が分かる文言） */
  title: string;
}

const { id, title } = Astro.props;
const src = `https://www.youtube-nocookie.com/embed/${encodeURIComponent(id)}?rel=0`;
---

<div class="yt-embed">
  <iframe
    src={src}
    title={title}
    loading="lazy"
    referrerpolicy="strict-origin-when-cross-origin"
    allow="accelerometer; encrypted-media; gyroscope; picture-in-picture; web-share"
    allowfullscreen
  ></iframe>
</div>

<style>
  .yt-embed {
    margin: 1.5rem 0;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #0b0c15;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .yt-embed iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
