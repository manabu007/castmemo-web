---
/**
 * CastMemo アプリアイコン表示。
 *
 * 表示ロジック（優先順）:
 *   1. public/images/app-icon-256.png（+512）… `npm run generate:assets` が
 *      正式アイコンの元画像 assets/source/app-icon.png から生成した Web 最適化版。
 *   2. 自作 SVG プレースホルダー（濃紺 + 紫/青 + メモ帳 + 人物3人 + 関係線・外部素材なし）。
 *
 * ※元画像 assets/source/app-icon.png は Web からは直接参照しない（配信もしない）。
 */
import { publicAsset } from '../lib/assets';

interface Props {
  /** 表示サイズ(px)。CSS 側で上限も効かせる */
  size?: number;
  /** 装飾目的なら空 alt、意味を持たせるなら文言を渡す */
  alt?: string;
  class?: string;
}

const { size = 96, alt = '', class: className } = Astro.props;

const optimized = publicAsset('/images/app-icon-256.png');
const optimized2x = publicAsset('/images/app-icon-512.png');
const iconSrc = optimized;
const srcset = optimized && optimized2x ? `${optimized} 1x, ${optimized2x} 2x` : undefined;

// 正式アイコンは角丸済みの想定だが、環境差に備え軽く角丸を当てる
const rounded = Math.round(size * 0.225);
---

{
  iconSrc ? (
    <img
      src={iconSrc}
      srcset={srcset}
      width={size}
      height={size}
      alt={alt}
      class:list={['app-icon', className]}
      style={`border-radius:${rounded}px`}
      loading="lazy"
      decoding="async"
    />
  ) : (
    <svg
      class:list={['app-icon', 'app-icon--placeholder', className]}
      width={size}
      height={size}
      viewBox="0 0 96 96"
      role="img"
      aria-label={alt || 'CastMemo アイコン'}
    >
      <defs>
        <linearGradient id="castmemo-icon-grad" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#7c5cff" />
          <stop offset="1" stop-color="#4f7cff" />
        </linearGradient>
      </defs>
      <rect width="96" height="96" rx="21.6" fill="#16172a" />
      <rect x="1.5" y="1.5" width="93" height="93" rx="20.1" fill="none" stroke="url(#castmemo-icon-grad)" stroke-width="1.5" opacity="0.5" />
      {/* メモ帳 */}
      <rect x="24" y="20" width="48" height="56" rx="7" fill="#282a44" stroke="url(#castmemo-icon-grad)" stroke-width="2" />
      {/* 人物3人 + 関係線 */}
      <g stroke="url(#castmemo-icon-grad)" stroke-width="3" stroke-linecap="round" fill="none">
        <path d="M37 44 51 58 M59 40 51 58 M37 44 59 40" opacity="0.9" />
      </g>
      <g fill="#f7f7fb">
        <circle cx="37" cy="42" r="5" />
        <circle cx="59" cy="38" r="5" />
        <circle cx="51" cy="60" r="5" />
      </g>
    </svg>
  )
}

<style>
  .app-icon {
    display: block;
    width: 100%;
    max-width: var(--app-icon-max, 7rem);
    height: auto;
    aspect-ratio: 1 / 1;
  }

  .app-icon--placeholder {
    border-radius: 22.5%;
    box-shadow: var(--shadow-brand, 0 12px 40px rgba(10, 11, 24, 0.4));
  }
</style>
